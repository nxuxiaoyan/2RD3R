library(doParallel)
library(parallel)
source("Data_generate.R")
source("B_pen.R")

RDRR <- function(X_all, Y_all, m, eta, lam,
                 kappa_1,          
                 kappa_2,
                 tau_1,
                 tau_2,
                 T_comm, 
                 max_inner, 
                 delta = 1e-6) {
  N <- nrow(X_all)
  p <- ncol(X_all); q <- ncol(Y_all)
  
  cut_off <- function(mat, thresh) {
    if (!is.finite(thresh) || thresh <= 0) return(mat)
    row_norm <- (rowSums(abs(mat)^4))^(1/4)
    scale <- pmin(1, thresh / row_norm)
    return(mat * scale)
  }
  
  soft_thresh <- function(x, eta, lam) {
    pmax(abs(x) - eta * lam, 0) * sign(x)
  }
  svd_thresh <- function(C, eta, lam) {
    svdC <- svd(C)
    d <- soft_thresh(svdC$d, eta, lam)
    return(svdC$u %*% diag(d) %*% t(svdC$v))
  }
  grad_fun <- function(X_blk, Y_blk, B) {
    (t(X_blk) %*% X_blk %*% B - t(X_blk) %*% Y_blk) / nrow(X_blk)
  }
  
  global_gradient <- function(X, Y, B, m) {
    N_all <- nrow(X)
    chunk_size <- ceiling(N_all / m)
    cl <- makePSOCKcluster(m)
    registerDoParallel(cl)
    on.exit({ stopCluster(cl); registerDoSEQ() })
    clusterExport(cl, c("grad_fun"), envir = environment())
    grads <- foreach(i = seq_len(m), .combine = list, .multicombine = TRUE) %dopar% {
      idx1 <- (i - 1) * chunk_size + 1
      idx2 <- min(i * chunk_size, N_all)
      grad_fun(X[idx1:idx2, , drop = FALSE], Y[idx1:idx2, , drop = FALSE], B)
    }
    Reduce("+", grads) / length(grads)
  }
  
 
  n_blk <- as.integer(N / m)
  X_central_shrink <- cut_off(X_all[1:n_blk, , drop = FALSE], kappa_1)
  Y_central_shrink <- cut_off(Y_all[1:n_blk, , drop = FALSE], kappa_2)
  X_all_shrink <- cut_off(X_all, tau_1)
  Y_all_shrink <- cut_off(Y_all, tau_2)
  
  B_T <- B_pen(X_central_shrink, Y_central_shrink, eta, lam, max_iter = 300, tol = delta)
  
  compute_obj <- function(B, Xc, Yc, grad1, G) {
    
    n <- nrow(Xc)
    XB <- Xc %*% B
    L1 <- 0.5 * mean(rowSums(XB^2)) - mean(rowSums(XB * Yc))
    inner <- sum((grad1 - G) * B)
    return(L1 - inner)
  }
  
  # ---------- main ----------
  for (t in 1:T_comm) {
    old_B <- B_T  
    
    G_global <- global_gradient(X_all_shrink, Y_all_shrink, old_B, m)
    local_gradi_T <- grad_fun(X_central_shrink, Y_central_shrink, old_B)
   
    obj_old <- compute_obj(old_B, X_central_shrink, Y_central_shrink, local_gradi_T, G_global)
    
    B0 <- old_B
    B1 <- old_B
    alpha0 <- 0; alpha1 <- 1
    for (k in 1:max_inner) {
      local_gradi_k <- grad_fun(X_central_shrink, Y_central_shrink, B1)
      S <- B1 + (alpha0 - 1) / alpha1 * (B1 - B0)
      A <- S - eta * (local_gradi_k - local_gradi_T + G_global)
      B_new <- svd_thresh(A, eta, lam)
      if (norm(B_new - B1, "F") < delta) {
        B1 <- B_new
        break
      }
      B0 <- B1
      B1 <- B_new
      alpha_next <- (1 + sqrt(1 + 4 * alpha1^2)) / 2
      alpha0 <- alpha1
      alpha1 <- alpha_next
    }
    
    obj_new <- compute_obj(B1, X_central_shrink, Y_central_shrink, local_gradi_T, G_global)
    
    if (obj_new > obj_old) {
      warning(sprintf("Objective increased by %.6f at round %d!", obj_new - obj_old, t))
    }
    
    if (norm(B1 - old_B, "F") < delta) {
      B_T <- B1
      cat("Converged at outer round", t, "\n")
      break
    }
    
    B_T <- B1
    
  }
  return(B_T)
}


