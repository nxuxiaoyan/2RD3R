source("Data_generate.R")

B_pen <- function(X_local, Y_local, eta, lam, max_iter, tol) {
  n <- nrow(X_local)
  p <- ncol(X_local)
  q <- ncol(Y_local)
  
  XtX <- crossprod(X_local)
  XtY <- crossprod(X_local, Y_local)
  
  B <- matrix(0, p, q)        
  B_prev <- B                 
  t <- 1                      
  
  for (k in 1:max_iter) {
  
    t_new <- (1 + sqrt(1 + 4 * t^2)) / 2
    Y <- B + ((t - 1) / t_new) * (B - B_prev)
    grad <- (XtX %*% Y - XtY) / n
    A <- Y - eta * grad
    svdA <- svd(A)
    d <- pmax(svdA$d - eta * lam, 0)
    r <- length(d)
    B_new <- svdA$u[, 1:r] %*% diag(d) %*% t(svdA$v[, 1:r])
    
    if (norm(B_new - B, "F") < tol) {
      B <- B_new
      cat("Converged at iteration", k, "\n")
      break
    }
   
    B_prev <- B
    B <- B_new
    t <- t_new
  }
  
  return(B)
}


