import numpy as np
from Data_generate import Data_generate
np.set_printoptions(suppress=True)


def B_pen (X_all, Y_all, eta, lam, tau_1, tau_2):
    #n = int(len(X)/m)
    p = np.shape(X_all)[1]
    q = np.shape(Y_all)[1]
    B_init = np.zeros((p,q))
    

    def softThres(x, eta, lam, tol=1e-4):
        for i in range(len(x)):
            x_i = x[i]
            if x_i > eta * lam:
                x[i] = x_i - eta * lam
            else:
                x[i] = 0
        x[x < tol] = 0
        return x
        
    def svdThres(C, eta, lam):
            U, S, VT = np.linalg.svd(C, full_matrices = False)
            s = softThres(S, eta, lam)
            s = np.diag(s)
            C = U @ s @ VT
            return C
    
    def cut_off(X, trun_para):
         X_truncated = X.copy()
         for i in range(len(X_truncated)):
             x_i_norm = np.linalg.norm(X_truncated[i], ord=4)
             if x_i_norm > trun_para:
                 X_truncated[i] = (trun_para / x_i_norm) * X_truncated[i]
         return X_truncated
      
    def compute_gradient(X_block, Y_block, S):
        gradient =  (X_block.T @ X_block @ S - X_block.T @ Y_block) / len(X_block)
        return gradient
    
    X_all_shrink = X_all  #cut_off(X_all, tau_1)
    Y_all_shrink = cut_off(Y_all, tau_2)
    B_new = B_init
    for j in range(200):
        B_old = B_new
        local_gradi_K = compute_gradient(X_all_shrink, Y_all_shrink, B_old)
        A = B_old - eta * local_gradi_K 
        B_new = svdThres(A, eta, lam)
        delta_B = np.linalg.norm(B_new - B_old, 'fro')
        if delta_B < 1e-4:
            print(j)
            break
    return B_new

