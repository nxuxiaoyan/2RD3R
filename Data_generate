###Data.generate
options(scipen = 999)

Data_generate <- function(n, p, q, r, scenario) {
  
  generate_B_star <- function(p, q, r) {
    U_Gamma <- matrix(runif(n = p * r, min = 0, max = 1), nrow = p, ncol = r)
    V_Gamma <- matrix(runif(n = r * q, min = 0, max = 1), nrow = r, ncol = q)
    B_star <- U_Gamma %*% V_Gamma
    return(B_star)
  }
  
  generate_sigma_matrix <- function(p) {
    Sigma <- matrix(0, nrow = p, ncol = p)
    for (i in 1:p) {
      for (j in 1:p) {
        Sigma[i, j] <- 0.5 ^ abs(i - j)
      }
    }
    return(Sigma)
  }
  
  generate_X <- function(n, p) {
    Sigma <- generate_sigma_matrix(p)
    X <- MASS::mvrnorm(n = n, mu = rep(0, p), Sigma = Sigma)
    return(X)
  }
  
  generate_data <- function(B, n, scenario) {
    p <- nrow(B)
    q <- ncol(B)
    X <- generate_X(n, p)
    
    # Scenario 1
    if (scenario == 'scenario1') {
      E <- matrix(rnorm(n = n * q, mean = 0, sd = sqrt(1)), nrow = n, ncol = q)
      Y <- X %*% B + E 
    }
    
    # Scenario 2
    else if (scenario == 'scenario2') {
      E <- sqrt(2) * matrix(rt(n = n * q, df = 4), nrow = n, ncol = q)
      Y <- X %*% B + E  
    }
    
    # Scenario 3
    else if (scenario == 'scenario3') {
      E <- matrix(rcauchy(n = n * q), nrow = n, ncol = q) / 128
      Y <- X %*% B + E  
    }
    
    # Scenario 4
    else if (scenario == 'scenario4') {
      E <- matrix(rnorm(n = n * q, mean = 0, sd = sqrt(20)), nrow = n, ncol = q)
      X <- sqrt(2) * matrix(rt(n = n * p, df = 4), nrow = n, ncol = p)
      Y <- X %*% B + E  
    }
    
    # Scenario 5
    else if (scenario == 'scenario5') {
      outlier_indices <- sample(x = 1:n, size = floor(0.1 * n), replace = FALSE)
      
      xi <- matrix(
        rnorm(n = length(outlier_indices) * p, mean = 0, sd = sqrt(5)),
        nrow = length(outlier_indices),
        ncol = p
      )
      X[outlier_indices, ] <-  xi
      
      E <- matrix(rnorm(n = n * q, mean = 0, sd = sqrt(1)), nrow = n, ncol = q)
      Y <- X %*% B + E  
    }
    
    # Scenario 6
    else if (scenario == 'scenario6') {
      sigma_squared <- 7.84 
      sigma <- sqrt(sigma_squared)  
      E_Z <- exp(sigma_squared / 2) 
      Z_X <- matrix(rlnorm(n = n * p, meanlog = 0, sdlog = sigma), nrow = n, ncol = p)
      X <- (exp(Z_X) - E_Z) / 500  
      Z_Y <- matrix(rlnorm(n = n * p, meanlog = 0, sdlog = sigma), nrow = n, ncol = p)
      E <- (exp(Z_Y) - E_Z) / 500  
      Y <- X %*% B + E  
    }
    return(list(X = X, Y = Y))
  }
  
  B_star <- generate_B_star(p, q, r)  
  data <- generate_data(B_star, n, scenario) 
  X <- data$X 
  Y <- data$Y 
  return(list(B_star = B_star, X = X, Y = Y))
}

